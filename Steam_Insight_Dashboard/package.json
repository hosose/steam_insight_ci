{
  "name": "sinsa",
  "private": true,
  "version": "1.0.0",
  "description": "Steam 인사이트 플랫폼 - 스인싸",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix app/web-html",
    "dev:backend": "npm run dev --prefix app/was",
    "build": "npm run build --prefix app/was && npm run build --prefix app/web-html",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
